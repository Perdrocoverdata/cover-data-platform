---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

const { title = "CoverData", lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Favicon (icono del escudo en la pestaña) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/escudo.png" />
  </head>

  <body>
    <CookieBanner />
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  /* Utility container: úsala en páginas "normales" (privacidad, contacto, etc.) */
  :global(.container) {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  /* Evita márgenes raros por defecto */
  body {
    margin: 0;
  }
</style>
