---
const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} | Cover Data` : "Cover Data"}</title>
  </head>

  <body>

    <!-- HEADER INSERTADO AQUÍ -->
    <header class="cd-header">
      <nav class="cd-menu">
        <ul>
          <li><a href="/es/">Inicio</a></li>

          <li class="submenu">
            <a href="#">Servicios</a>
            <ul class="children">
              <li><a href="/es/rgpd-ia">Delegado de Protección de Datos</a></li>
              <li><a href="#">ISO 27001</a></li>
              <li><a href="#">ISO 31000</a></li>
              <li><a href="#">DORA</a></li>
              <li><a href="#">Reglamento de IA</a></li>
              <li><a href="#">RGPD Compliance</a></li>
              <li><a href="#">Sectores</a></li>
            </ul>
          </li>

          <li><a href="/es/por-que-elegirnos">Quiénes somos</a></li>

          <li class="submenu">
            <a href="#">Formación</a>
            <ul class="children">
              <li><a href="#">RGPD empleados</a></li>
              <li><a href="#">Ciberseguridad</a></li>
              <li><a href="#">Concienciación</a></li>
            </ul>
          </li>

          <li><a href="/es/contacto">Contacto</a></li>
        </ul>
      </nav>
    </header>

    <!-- CONTENIDO DE CADA PÁGINA -->
    <main>
      <slot />
    </main>

  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap');

  .cd-header {
    background: #0a2a43;
  }

  .cd-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    font-family: 'Montserrat', sans-serif;
  }

  .cd-menu ul li {
    position: relative;
  }

  .cd-menu ul li a {
    display: block;
    padding: 16px 22px;
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
  }

  .cd-menu ul li:hover {
    background: #0d3b5a;
  }

  .submenu .children {
    display: none;
    position: absolute;
    background: #0a2a43;
    top: 100%;
    left: 0;
    min-width: 240px;
    padding: 0;
    border-top: 2px solid #1e90ff;
  }

  .submenu:hover .children {
    display: block;
  }

  .children li a {
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 400;
  }

  .children li a:hover {
    background: #0d3b5a;
  }
</style>
