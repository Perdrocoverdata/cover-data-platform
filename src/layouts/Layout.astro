---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title = "CoverData" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }
</style>

