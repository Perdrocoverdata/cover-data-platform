---
import Layout from "../../layouts/Layout.astro";

const servicios = [
  {
    title: "Auditoría RGPD",
    price: "desde 490 €",
    text: "Revisión completa de cumplimiento, análisis de brechas y plan de adecuación legal."
  },
  {
    title: "Cumplimiento IA / AI Act",
    price: "desde 390 €",
    text: "Clasificación de sistemas, requisitos, gobernanza y documentación técnica."
  },
  {
    title: "Delegado de Protección de Datos (DPD externo)",
    price: "desde 90 €/mes",
    text: "Supervisión continua, informes, atención a interesados y soporte legal-técnico."
  }
];

const complementarios = [
  "Evaluación de riesgos",
  "DPIA / PIA",
  "Resolución de dudas legales y técnicas",
  "ISO 27001",
  "ENS (básico, medio y alto)",
  "Gestión de brechas de seguridad",
  "Transferencias internacionales y SCC",
  "Revisión de contratos y proveedores",
  "Políticas y documentación",
  "Formación interna"
];
---

<Layout title="Servicios — CoverData">
  <section class="wrap">
    <h1 class="h1">Servicios</h1>
    <p class="lead">Soluciones de cumplimiento diseñadas para empresas tecnológicas y startups.</p>

    <div class="cards">
      {servicios.map(s => (
        <div class="card">
          <div class="cardtitle">{s.title}</div>
          <div class="cardprice">{s.price}</div>
          <div class="cardtext">{s.text}</div>
        </div>
      ))}
    </div>

    <h2 class="h2">Servicios complementarios</h2>
    <ul class="list">
      {complementarios.map(item => <li>{item}</li>)}
    </ul>
  </section>
</Layout>

<style>
.wrap{ max-width:1100px; margin:0 auto; padding:72px 20px; color:#fff; }
.h1{ font-size:42px; font-weight:700; margin-bottom:12px; }
.h2{ margin-top:48px; font-size:28px; font-weight:700; }
.lead{ margin-bottom:32px; max-width:640px; color:rgba(255,255,255,.85); }
.cards{ display:grid; gap:20px; margin-top:32px; }
@media(min-width:900px){ .cards{ grid-template-columns:repeat(3,1fr); } }
.card{ background:#fff; color:#0f172a; padding:24px; border-radius:20px; box-shadow:0 6px 16px rgba(0,0,0,.12); }
.cardtitle{ font-size:20px; font-weight:700; }
.cardprice{ margin:6px 0 12px; font-weight:600; color:#0A2446; }
.list{ margin-top:16px; line-height:1.6; }
</style>


