---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Por qué elegirnos — CoverData">
  <section class="wrap">
    <h1 class="h1">Por qué elegir CoverData</h1>
    <p class="lead">Un enfoque práctico, rápido y orientado al negocio.</p>

    <div class="reasons">
      <div class="reason">Especialistas en empresas tecnológicas y startups</div>
      <div class="reason">Cumplimiento sin frenar la innovación</div>
      <div class="reason">Documentación lista para auditoría</div>
      <div class="reason">Acompañamiento legal + técnico</div>
      <div class="reason">Tarifas claras y sin sorpresas</div>
      <div class="reason">Respuesta rápida y soporte continuo</div>
    </div>
  </section>
</Layout>

<style>
.wrap{ max-width:900px; margin:0 auto; padding:72px 20px; color:#fff; }
.h1{ font-size:42px; font-weight:700; margin-bottom:12px; }
.lead{ margin-bottom:32px; max-width:600px; color:rgba(255,255,255,.85); }
.reasons{ display:grid; gap:16px; margin-top:24px; }
.reason{ background:rgba(255,255,255,.08); padding:18px; border-radius:14px; }
</style>
