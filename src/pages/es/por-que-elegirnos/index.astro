---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Por qué elegir CoverData — Consultoría RGPD & IA">
  <section class="hero">
    <div class="wrap">
      <h1 class="h1">Por qué elegir CoverData</h1>
      <p class="lead">
        Un enfoque práctico, rápido y orientado al negocio. Cumplimiento sin frenar la innovación.
      </p>

      <div class="reasons">
        <div class="reason">Especialistas en empresas tecnológicas y startups</div>
        <div class="reason">Cumplimiento sin frenar el desarrollo del producto</div>
        <div class="reason">Documentación lista para auditoría</div>
        <div class="reason">Acompañamiento legal + técnico</div>
        <div class="reason">Tarifas claras y sin sorpresas</div>
        <div class="reason">Respuesta rápida y soporte continuo</div>
      </div>
    </div>
  </section>
</Layout>

<style>
.hero{
  background: linear-gradient(180deg, #071A33 0%, #0A2446 100%);
  padding: 80px 0;
  color: #fff;
}

.wrap{
  max-width: 900px;
  margin: 0 auto;
  padding: 0 20px;
}

.h1{
  font-size: 42px;
  font-weight: 700;
  margin-bottom: 12px;
}

.lead{
  margin-bottom: 32px;
  max-width: 600px;
  color: rgba(255,255,255,.85);
  line-height: 1.55;
}

.reasons{
  display: grid;
  gap: 16px;
  margin-top: 24px;
}

.reason{
  background: rgba(255,255,255,.08);
  padding: 18px;
  border-radius: 14px;
  line-height: 1.5;
  box-shadow: 0 4px 12px rgba(0,0,0,.1);
}
</style>

