---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Contacto — CoverData">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1 class="h1">Contacto</h1>
      <p class="lead">
        Agenda una reunión de 30 minutos o envíanos tu consulta.  
        Te responderemos en menos de 24 horas.
      </p>
    </div>
  </section>

  <!-- FORM -->
  <section class="wrap form-section">
    <form class="form" action="https://api.web3forms.com/submit" method="POST">

      <!-- Web3Forms required -->
      <input type="hidden" name="access_key" value="560278c0-a113-46f8-b40d-61c34653f23e" />
      <input type="hidden" name="from_name" value="Cover Data Website" />
      <input type="hidden" name="subject" value="Nuevo mensaje desde el formulario de contacto" />
      <input type="checkbox" name="botcheck" style="display:none;" />

      <label>
        Nombre
        <input type="text" name="name" required />
      </label>

      <label>
        Email
        <input type="email" name="email" required />
      </label>

      <label>
        Empresa
        <input type="text" name="company" />
      </label>

      <label>
        Mensaje
        <textarea name="message" rows="5" required></textarea>
      </label>

      <button type="submit" class="btn primary">Enviar mensaje</button>

      <p class="micro">
        Respuesta en menos de 24 horas • 100% confidencial
      </p>
    </form>
  </section>

</Layout>

<style>
.hero{
  background: linear-gradient(180deg, #071A33 0%, #0A2446 100%);
  padding: 80px 0;
  color:#071A33;
}
.wrap{
  max-width:700px;
  margin:0 auto;
  padding:0 20px;
}
.h1{
  font-size:42px;
  font-weight:700;
}
.lead{
  margin-top:12px;
  max-width:500px;
  color:rgba(255,255,255,.85);
  line-height:1.55;
  font-size:20px;
}

/* FORM */
.form-section{
  padding:64px 0;
  color:#fff;
}
.form{
  display:flex;
  flex-direction:column;
  gap:20px;
}
label{
  display:flex;
  flex-direction:column;
  font-weight:600;
  gap:6px;
}
input, textarea{
  padding:12px;
  border-radius:10px;
  border:none;
  font-size:16px;
}
.btn{
  padding:12px 20px;
  border-radius:12px;
  font-weight:700;
  text-decoration:none;
  font-size:16px;
  cursor:pointer;
}
.primary{
  background:#fff;
  color:#071A33;
}
.micro{
  margin-top:8px;
  font-size:14px;
  color:rgba(255,255,255,.7);
}
</style>
