---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "RGPD & IA para empresas tecnológicas",
  sub: "Ayudamos a empresas tech a cumplir el RGPD y la normativa europea de IA, reduciendo riesgos legales y facilitando su crecimiento en Europa.",
};
---

<Layout title="CoverData — Consultoría RGPD & IA">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <header class="topbar">
        <div class="brandbox">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="brandlogo" />
          <div class="brandtext">
            <div class="brandname">{brand.name}</div>
            <div class="brandsub">GDPR & AI Compliance</div>
          </div>
        </div>

        <div class="lang">
          <a href="/es/" class="active">ES</a>
          <span class="sep">|</span>
          <a href="/en/">EN</a>
        </div>
      </header>

      <h1 class="h1">{brand.claim}</h1>
      <p class="lead">{brand.sub}</p>

      <div class="cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
        <a class="btn ghost" href="/es/rgpd-ia">Ver servicios RGPD & IA</a>
      </div>

      <p class="micro">30 minutos • Sin compromiso • 100% confidencial</p>

      <!-- SERVICES -->
      <div class="cards">
        <div class="card">
          <div class="cardtitle">Auditoría RGPD</div>
          <div class="cardtext">
            Evaluación de riesgos, gap analysis y plan de adecuación legal.
          </div>
        </div>

        <div class="card">
          <div class="cardtitle">Cumplimiento IA</div>
          <div class="cardtext">
            Privacidad por diseño, DPIA y gobernanza de sistemas de IA.
          </div>
        </div>

        <div class="card">
          <div class="cardtitle">Expansión UE</div>
          <div class="cardtext">
            Transferencias internacionales, SCCs y gestión de proveedores.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust">
    <div class="trust-wrap">
      <span>Marco normativo europeo:</span>
      <strong>RGPD</strong>
      <strong>LOPDGDD</strong>
      <strong>AI Act</strong>
    </div>
  </section>

  <!-- HOW -->
  <section class="how">
    <div class="how-wrap">
      <h2 class="how-h2">Cómo trabajamos</h2>
      <p class="how-lead">
        Un enfoque práctico y alineado con el negocio: reducimos riesgos legales sin frenar el desarrollo del producto.
      </p>

      <div class="steps">
        <div class="step">
          <div class="step-title">1) Diagnóstico</div>
          <div class="step-text">
            Revisión de producto, datos, flujos y proveedores. Identificación de riesgos y quick wins.
          </div>
        </div>
        <div class="step">
          <div class="step-title">2) Plan de adecuación</div>
          <div class="step-text">
            Roadmap legal, políticas, DPIA/PIA y medidas técnicas y organizativas.
          </div>
        </div>
        <div class="step">
          <div class="step-title">3) Implementación</div>
          <div class="step-text">
            Acompañamiento con equipos legales y técnicos, con evidencias listas para auditoría.
          </div>
        </div>
      </div>

      <div class="final-cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
        <a class="btn ghost" href="/es/rgpd-ia">Ver RGPD & IA</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.hero{
  background: linear-gradient(180deg, #071A33 0%, #0A2446 100%);
}
.wrap{
  max-width:1100px;
  margin:0 auto;
  padding:72px 20px 64px;
  color:#fff;
}
.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.brandbox{
  display:flex;
  gap:16px;
  background:#fff;
  padding:16px 18px;
  border-radius:24px;
  color:#0f172a;
}
.brandlogo{
  height:96px;
}
@media (min-width:900px){
  .brandlogo{ height:112px; }
}
.brandname{ font-size:20px; font-weight:700; }
.brandsub{ font-size:12px; color:#475569; }
.h1{
  margin-top:40px;
  font-size:48px;
  font-weight:700;
}
.lead{
  margin-top:16px;
  max-width:640px;
  font-size:18px;
  color:rgba(255,255,255,.88);
}
.cta{ margin-top:20px; display:flex; gap:12px; }
.btn{
  padding:10px 16px;
  border-radius:12px;
  font-weight:700;
  text-decoration:none;
}
.primary{ background:#fff; color:#071A33; }
.ghost{ border:1px solid rgba(255,255,255,.4); color:#fff; }
.cards{
  margin-top:36px;
  display:grid;
  gap:16px;
}
@media (min-width:900px){
  .cards{ grid-template-columns:repeat(3,1fr); }
}
.card{
  background:#fff;
  color:#0f172a;
  padding:18px;
  border-radius:22px;
}
.trust{
  background:#06162b;
  padding:14px 20px;
  text-align:center;
}
.trust strong{
  background:rgba(255,255,255,.1);
  padding:6px 10px;
  border-radius:10px;
  margin-left:6px;
}
.how{
  background:#0A2446;
  padding:56px 0;
}
.how-wrap{
  max-width:1100px;
  margin:0 auto;
  padding:0 20px;
}
.steps{
  margin-top:24px;
  display:grid;
  gap:14px;
}
@media (min-width:900px){
  .steps{ grid-template-columns:repeat(3,1fr); }
}
.step{
  background:rgba(255,255,255,.08);
  padding:16px;
  border-radius:18px;
}
.final-cta{
  margin-top:24px;
  display:flex;
  gap:12px;
}
</style>

