---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "Cumplimiento RGPD & IA para empresas tecnológicas",
  sub: "Acompañamos a startups y empresas tech en su adecuación al RGPD y al AI Act europeo, reduciendo riesgos legales y acelerando su crecimiento en Europa.",
};

const servicios = [
  {
    title: "Auditoría RGPD",
    price: "desde 490 €",
    text: "Revisión completa de cumplimiento, análisis de brechas y plan de adecuación legal."
  },
  {
    title: "Cumplimiento IA / AI Act",
    price: "desde 390 €",
    text: "Clasificación de sistemas, requisitos, gobernanza y documentación técnica."
  },
  {
    title: "Delegado de Protección de Datos (DPD externo)",
    price: "desde 90 €/mes",
    text: "Supervisión continua, informes, atención a interesados y soporte legal‑técnico."
  }
];

const pasos = [
  {
    title: "1) Diagnóstico",
    text: "Revisión de producto, datos, flujos y proveedores. Identificación de riesgos y quick wins."
  },
  {
    title: "2) Plan de adecuación",
    text: "Roadmap legal, políticas, DPIA/PIA y medidas técnicas y organizativas."
  },
  {
    title: "3) Implementación",
    text: "Acompañamiento con equipos legales y técnicos, con evidencias listas para auditoría."
  }
];

const razones = [
  "Especialistas en empresas tecnológicas y startups",
  "Cumplimiento sin frenar la innovación",
  "Documentación lista para auditoría",
  "Acompañamiento legal + técnico",
  "Tarifas claras y sin sorpresas",
  "Respuesta rápida y soporte continuo"
];
---

<Layout title="CoverData — Consultoría RGPD & IA">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <header class="topbar">
        <div class="brandbox">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="brandlogo" />
          <div class="brandtext">
            <div class="brandname">{brand.name}</div>
            <div class="brandsub">GDPR & AI Compliance</div>
          </div>
        </div>

        <div class="lang">
          <a href="/es/" class="active">ES</a>
          <span class="sep">|</span>
          <a href="/en/">EN</a>
        </div>
      </header>

      <h1 class="h1">{brand.claim}</h1>
      <p class="lead">{brand.sub}</p>

      <div class="cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
        <a class="btn ghost" href="/es/rgpd-ia">Ver servicios RGPD & IA</a>
      </div>

      <p class="micro">30 minutos • Sin compromiso • 100% confidencial</p>

      <!-- SERVICES -->
      <div class="cards">
        {servicios.map(s => (
          <div class="card">
            <div class="cardtitle">{s.title}</div>
            <div class="cardprice">{s.price}</div>
            <div class="cardtext">{s.text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust">
    <div class="trust-wrap">
      <span>Marco normativo europeo:</span>
      <strong>RGPD</strong>
      <strong>LOPDGDD</strong>
      <strong>AI Act</strong>
    </div>
  </section>

  <!-- HOW -->
  <section class="how">
    <div class="how-wrap">
      <h2 class="how-h2">Cómo trabajamos</h2>
      <p class="how-lead">
        Un enfoque práctico y alineado con negocio: mitigamos riesgos legales sin frenar la innovación ni el desarrollo del producto.
      </p>

      <div class="steps">
        {pasos.map(p => (
          <div class="step">
            <div class="step-title">{p.title}</div>
            <div class="step-text">{p.text}</div>
          </div>
        ))}
      </div>

      <div class="final-cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
        <a class="btn ghost" href="/es/rgpd-ia">Ver RGPD & IA</a>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why">
    <div class="why-wrap">
      <h2 class="why-h2">Por qué elegirnos</h2>
      <div class="why-grid">
        {razones.map(r => (
          <div class="why-item">{r}</div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
/* HERO */
.hero{
  background: linear-gradient(180deg, #071A33 0%, #0A2446 100%);
  padding-bottom: 80px;
}
.wrap{
  max-width:1100px;
  margin:0 auto;
  padding:96px 20px 64px;
  color:#fff;
}
.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.brandbox{
  display:flex;
  gap:16px;
  background:#fff;
  padding:16px 18px;
  border-radius:24px;
  color:#0f172a;
  box-shadow:0 4px 12px rgba(0,0,0,.15);
}
.brandlogo{
  height:96px;
}
@media (min-width:900px){
  .brandlogo{ height:112px; }
}
.brandname{ font-size:20px; font-weight:700; }
.brandsub{ font-size:12px; color:#475569; }
.h1{
  margin-top:48px;
  font-size:52px;
  font-weight:700;
  line-height:1.15;
}
.lead{
  margin-top:20px;
  max-width:640px;
  font-size:20px;
  color:rgba(255,255,255,.88);
  line-height:1.55;
}
.cta{ margin-top:28px; display:flex; gap:14px; }
.btn{
  padding:12px 20px;
  border-radius:12px;
  font-weight:700;
  text-decoration:none;
  font-size:16px;
}
.primary{ background:#fff; color:#071A33; }
.ghost{ border:1px solid rgba(255,255,255,.4); color:#fff; }

/* SERVICES */
.cards{
  margin-top:48px;
  display:grid;
  gap:20px;
}
@media (min-width:900px){
  .cards{ grid-template-columns:repeat(3,1fr); }
}
.card{
  background:#fff;
  color:#0f172a;
  padding:24px;
  border-radius:22px;
  min-height:180px;
  box-shadow:0 6px 16px rgba(0,0,0,.12);
}
.cardtitle{
  font-size:20px;
  font-weight:700;
}
.cardprice{
  margin:6px 0 12px;
  font-weight:600;
  color:#0A2446;
}

/* TRUST */
.trust{
  background:#06162b;
  padding:20px 20px;
  text-align:center;
  margin-top:-20px;
}
.trust strong{
  background:rgba(255,255,255,.1);
  padding:6px 10px;
  border-radius:10px;
  margin-left:6px;
  letter-spacing:0.3px;
}

/* HOW */
.how{
  background:linear-gradient(180deg, #0A2446 0%, #071A33 100%);
  padding:80px 0;
}
.how-wrap{
  max-width:1100px;
  margin:0 auto;
  padding:0 20px;
}
.steps{
  margin-top:32px;
  display:grid;
  gap:20px;
}
@media (min-width:900px){
  .steps{ grid-template-columns:repeat(3,1fr); }
}
.step{
  background:rgba(255,255,255,.08);
  padding:24px;
  border-radius:18px;
  line-height:1.55;
  min-height:180px;
  box-shadow:0 4px 12px rgba(0,0,0,.1);
}
.final-cta{
  margin-top:32px;
  display:flex;
  gap:14px;
}

/* WHY */
.why{
  background:#071A33;
  padding:64px 0;
}
.why-wrap{
  max-width:1100px;
  margin:0 auto;
  padding:0 20px;
  color:#fff;
}
.why-h2{
  font-size:32px;
  font-weight:700;
}
.why-grid{
  margin-top:24px;
  display:grid;
  gap:16px;
}
@media(min-width:900px){
  .why-grid{ grid-template-columns:repeat(3,1fr); }
}
.why-item{
  background:rgba(255,255,255,.08);
  padding:20px;
  border-radius:14px;
  text-align:center;
}
</style>
