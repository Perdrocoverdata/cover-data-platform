---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "Cumplimiento RGPD y Ley de IA para empresas tecnológicas",
  sub: "Acompañamos a startups y compañías tecnológicas en la implantación del RGPD y del Reglamento Europeo de IA, reduciendo riesgos legales y facilitando un crecimiento seguro en Europa."
};

const services = [
  {
    title: "Auditoría RGPD",
    price: "desde 490 €",
    bullets: [
      "Análisis de brechas y riesgos",
      "Revisión de documentación y proveedores",
      "Plan de adecuación priorizado"
    ]
  },
  {
    title: "Cumplimiento IA / AI Act",
    price: "desde 390 €",
    bullets: [
      "Clasificación del sistema según el AI Act",
      "Evaluación de riesgos y gobernanza",
      "Documentación técnica y medidas obligatorias"
    ]
  },
  {
    title: "Delegado de Protección de Datos (DPD externo)",
    price: "desde 90 €/mes",
    bullets: [
      "Supervisión continua",
      "Atención a interesados",
      "Informes y evidencias listas para auditoría"
    ]
  }
];

const steps = [
  {
    title: "1) Análisis inicial",
    text: "Revisión del producto, flujos de datos y proveedores. Identificación de riesgos y quick wins."
  },
  {
    title: "2) Plan de cumplimiento",
    text: "Roadmap legal, políticas, DPIA/PIA y medidas técnicas y organizativas."
  },
  {
    title: "3) Implementación",
    text: "Acompañamiento a equipos legales y técnicos con evidencias listas para auditoría."
  }
];

const reasons = [
  "Especialistas en startups y empresas tecnológicas",
  "Cumplimiento sin frenar la innovación",
  "Documentación lista para auditoría",
  "Soporte legal + técnico",
  "Precios transparentes",
  "Respuesta rápida y acompañamiento continuo"
];
---

<Layout title="CoverData — Cumplimiento RGPD y Ley de IA">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <header class="topbar">
        <div class="brandbox">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="brandlogo" />
          <div class="brandtext">
            <div class="brandname">{brand.name}</div>
            <div class="brandsub">RGPD & Ley de IA</div>
          </div>
        </div>

        <div class="lang">
          <a href="/es/" class="active">ES</a>
          <span class="sep">|</span>
          <a href="/en/">EN</a>
        </div>
      </header>

      <h1 class="h1">{brand.claim}</h1>
      <p class="lead">{brand.sub}</p>

      <div class="cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
        <a class="btn ghost" href="/es/rgpd-ia">Ver servicios RGPD & IA</a>
      </div>

      <p class="micro">30 minutos • Sin compromiso • 100% confidencial</p>

      <!-- SERVICES -->
      <div class="cards">
        {services.map(s => (
          <div class="card">
            <div class="cardtitle">{s.title}</div>
            <div class="cardprice">{s.price}</div>
            <ul class="cardlist">
              {s.bullets.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust">
    <div class="trust-wrap">
      <span>Marco regulatorio europeo:</span>
      <strong>RGPD</strong>
      <strong>LOPDGDD</strong>
      <strong>AI Act</strong>
    </div>
  </section>

  <!-- HOW -->
  <section class="how">
    <div class="how-wrap">
      <h2 class="how-h2">Cómo trabajamos</h2>
      <p class="how-lead">
        <strong>Un enfoque práctico y alineado con negocio:</strong> reducimos riesgos legales sin frenar la innovación ni el desarrollo del producto.
      </p>

      <div class="steps">
        {steps.map(step => (
          <div class="step">
            <div class="step-title"><strong>{step.title}</strong></div>
            <div class="step-text">{step.text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why">
    <div class="why-wrap">
      <h2 class="why-h2">Por qué elegirnos</h2>

      <ul class="why-list">
        {reasons.map(r => <li><strong>{r}</strong></li>)}
      </ul>
    </div>
  </section>

  <!-- INSIGHTS -->
  <section class="insights">
    <div class="insights-wrap">
      <h2 class="insights-h2">Artículos y recursos</h2>
      <p class="insights-lead">
        Guías prácticas y actualizaciones relevantes de fuentes oficiales como la Agencia Española de Protección de Datos (AEPD) y el Comité Europeo de Protección de Datos (CEPD).
      </p>

      <div class="insights-grid">

        <article class="insight-card">
          <h3 class="insight-title">AEPD: Principios clave para sistemas de IA</h3>
          <p class="insight-text">
            La AEPD destaca la transparencia, la evaluación de riesgos y la minimización de datos como pilares esenciales para la gobernanza de IA.
          </p>
          <a href="https://www.aepd.es" target="_blank" class="insight-link">Leer más</a>
        </article>

        <article class="insight-card">
          <h3 class="insight-title">CEPD: Directrices sobre transferencias internacionales</h3>
          <p class="insight-text">
            El CEPD ofrece recomendaciones prácticas para evaluar riesgos en terceros países y aplicar medidas adicionales cuando se usan proveedores cloud fuera de la UE.
          </p>
          <a href="https://edpb.europa.eu" target="_blank" class="insight-link">Leer más</a>
        </article>

        <article class="insight-card">
          <h3 class="insight-title">AEPD: Buenas prácticas para las DPIA</h3>
          <p class="insight-text">
            La guía de la AEPD explica cuándo es obligatoria una evaluación de impacto y cómo analizar tratamientos de alto riesgo.
          </p>
          <a href="https://www.aepd.es" target="_blank" class="insight-link">Leer más</a>
        </article>

      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-final">
    <div class="cta-wrap">
      <h2 class="cta-title">¿Necesitas ayuda con RGPD o IA?</h2>
      <p class="cta-sub">Reserva una reunión de 30 minutos. Sin compromiso.</p>
      <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
    </div>
  </section>

</Layout>

<style>
/* IMPORT FONTS */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Source+Serif+Pro:wght@400;600;700&display=swap');

body, html {
  margin: 0;
  padding: 0;
  font-family: 'Inter', sans-serif;
}

h1, h2, h3, .h1, .how-h2, .why-h2, .insights-h2 {
  font-family: 'Source Serif Pro', serif;
  font-weight: 700;
  letter-spacing: -0.5px;
}

/* GENERAL */
:root{
  --primary:#071A33;
  --secondary:#0A2446;
  --accent:#1EC6D7;
  --accent2:#0FB3C9;
}

/* HERO */
.hero{
  background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
  padding: 140px 0 110px;
  color: #fff;
}

.wrap{
  max-width:1200px;
  margin:0 auto;
  padding:0 28px;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:60px;
}

.brandbox{
  display:flex;
  align-items:center;
  gap:40px; /* más espacio entre logo y texto */
}

.brandlogo{
  height:260px; /* LOGO MÁS GRANDE */
  max-height:260px;
  width:auto;
  object-fit:contain;
}

.brandname{
  font-size:42px;
  font-weight:800;
}

.brandsub{
  font-size:19px;
  opacity:.85;
}

.lang a{
  color:#fff;
  text-decoration:none;
  font-size:18px;
}
.lang .active{
  font-weight:700;
  color:var(--accent);
}

.h1{
  font-size:64px;
  font-weight:800;
  margin-bottom:28px;
  max-width:820px;
  line-height:1.15;
}

.lead{
  max-width:760px;
  font-size:24px;
  color:rgba(255,255,255,.9);
  line-height:1.7;
  margin-top:24px;
}

.cta{
  margin-top:40px;
  display:flex;
  gap:20px;
}

.btn{
  padding:18px 30px;
  border-radius:16px;
  font-weight:700;
  text-decoration:none;
  font-size:18px;
}

.primary{ 
  background:#fff; 
  color:var(--primary); 
}

.ghost{ 
  border:2px solid var(--accent); 
  color:var(--accent); 
}

.micro{
  margin-top:24px;
  font-size:16px;
  opacity:.85;
}

/* SERVICES */
.cards{
  margin-top:60px;
  display:grid;
  gap:32px;
}

@media(min-width:900px){
  .cards{ grid-template-columns:repeat(3,1fr); }
}

.card{
  background:#fff;
  color:#0f172a;
  padding:40px 36px;
  border-radius:24px;
  border:2px solid var(--accent);
  box-shadow:0 10px 24px rgba(0,0,0,.12);
  transition:transform .2s ease, box-shadow .2s ease;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:0 14px 32px rgba(0,0,0,.18);
}

.cardtitle{
  font-size:24px;
  font-weight:800;
  color:var(--primary);
}

.cardprice{
  margin-top:10px;
  font-size:19px;
  font-weight:700;
  color:var(--accent2);
}

.cardlist{
  margin-top:16px;
  padding-left:20px;
  line-height:1.7;
  font-size:17px;
}

/* TRUST */
.trust{
  background:#fff;
  padding:60px 0;
  text-align:center;
  border-top:4px solid var(--accent);
  border-bottom:4px solid var(--accent2);
}

.trust-wrap strong{
  margin:0 14px;
  font-size:20px;
  color:var(--primary);
}

/* HOW */
.how{
  padding:120px 0;
  background:#f4f8ff;
}

.how-wrap{
  padding-left:80px; /* margen izquierdo aumentado */
}

.how-h2{
  font-size:42px;
  margin-bottom:24px;
  color:var(--primary);
}

.how-lead{
  margin-top:28px;
  max-width:720px;
  line-height:1.8;
  font-size:22px;
  font-weight:500;
  color:#334155;
}

.steps{
  margin-top:50px;
  display:grid;
  gap:36px;
}

.step{
  background:#fff;
  padding:40px;
  border-radius:20px;
  border-left:6px solid var(--accent);
  box-shadow:0 10px 24px rgba(0,0,0,.08);
}

.step-title{
  font-size:24px;
  font-weight:700;
  color:var(--primary);
  margin-bottom:10px;
}

.step-text{
  font-size:19px;
  line-height:1.75;
  color:#475569;
}

/* WHY */
.why{
  padding:120px 0;
}

.why-wrap{
  padding-left:80px; /* margen izquierdo aumentado */
}

.why-h2{
  font-size:42px;
  font-weight:800;
  color:var(--primary);
}

.why-list{
  margin-top:36px;
  line-height:1.9;
  font-size:21px;
  max-width:760px;
}

.why-list li{
  margin-bottom:14px;
  padding-left:24px;
  position:relative;
}

.why-list li::before{
  content:"•";
  position:absolute;
  left:0;
  top:0;
  color:var(--accent);
  font-size:28px;
  line-height:20px;
}

/* INSIGHTS */
.insights{
  padding:90px 0;
  background:#ffffff;
}

.insights-wrap{
  max-width:1200px;
  margin:0 auto;
  padding:0 28px;
}

.insights-h2{
  font-size:40px;
  font-weight:800;
  color:var(--primary);
}

.insights-lead{
  margin-top:20px;
  max-width:720px;
  font-size:21px;
  line-height:1.75;
  color:#334155;
}

.insights-grid{
  margin-top:44px;
  display:grid;
  gap:32px;
}

@media(min-width:900px){
  .insights-grid{
    grid-template-columns:repeat(3,1fr);
  }
}

.insight-card{
  background:#f8fafc;
  padding:32px;
  border-radius:20px;
  border:2px solid var(--accent);
  box-shadow:0 8px 20px rgba(0,0,0,.08);
  transition:transform .2s ease, box-shadow .2s ease;
}

.insight-card:hover{
  transform:translateY(-4px);
  box-shadow:0 14px 28px rgba(0,0,0,.12);
}

.insight-title{
  font-size:22px;
  font-weight:700;
  color:var(--primary);
}

.insight-text{
  margin-top:12px;
  font-size:18px;
  line-height:1.7;
  color:#475569;
}

.insight-link{
  display:inline-block;
  margin-top:16px;
  font-weight:700;
  color:var(--accent);
  text-decoration:none;
}

/* CTA FINAL */
.cta-final{
  background:var(--primary);
  padding:100px 0;
  text-align:center;
  color:#fff;
  border-top:6px solid var(--accent);
}

.cta-title{
  font-size:42px;
  font-weight:800;
}

.cta-sub{
  margin-top:16px;
  margin-bottom:36px;
  color:rgba(255,255,255,.85);
}
</style>


