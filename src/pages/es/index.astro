---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "RGPD & IA para empresas tecnológicas",
  sub: "Te ayudamos a cumplir el RGPD y reducir riesgos en productos y procesos basados en datos e IA, para operar y vender en Europa con seguridad.",
  email: "info@cover-data.com",
};
---

<Layout title="CoverData — Consultoría RGPD & IA">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <header class="topbar">
        <div class="brandbox">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="brandlogo" />
          <div class="brandtext">
            <div class="brandname">{brand.name}</div>
            <div class="brandsub">GDPR & AI Compliance</div>
          </div>
        </div>

        <div class="lang">
          <a href="/es/" class="active">ES</a>
          <span class="sep">|</span>
          <a href="/en/">EN</a>
        </div>
      </header>

      <h1 class="h1">{brand.claim}</h1>
      <p class="lead">{brand.sub}</p>

      <!-- CTA -->
      <div class="cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
        <a class="btn ghost" href="/es/rgpd-ia">Ver servicios RGPD & IA</a>
      </div>

      <p class="micro">30 minutos • Sin compromiso • 100% confidencial</p>

      <!-- SERVICES -->
      <div class="cards">
        <div class="card">
          <div class="cardtitle">Auditoría RGPD</div>
          <div class="cardtext">Diagnóstico, gap analysis y plan de adecuación.</div>
        </div>

        <div class="card">
          <div class="cardtitle">Cumplimiento IA</div>
          <div class="cardtext">DPIA, privacidad por diseño y gobernanza de datos.</div>
        </div>

        <div class="card">
          <div class="cardtitle">Expansión UE</div>
          <div class="cardtext">Transferencias internacionales, SCCs y vendors.</div>
        </div>
      </div>

      <div class="contact">
        Contacto:
        <a href={`mailto:${brand.email}`}>{brand.email}</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust">
    <div class="trust-wrap">
      <span>Marco normativo europeo:</span>
      <strong>RGPD</strong>
      <strong>LOPDGDD</strong>
      <strong>AI Act</strong>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="how">
    <div class="how-wrap">
      <h2 class="how-h2">Cómo trabajamos</h2>
      <p class="how-lead">
        Un enfoque práctico, documentado y alineado con negocio: reducimos riesgos sin frenar el producto.
      </p>

      <div class="steps">
        <div class="step">
          <div class="step-title">1) Diagnóstico</div>
          <div class="step-text">Revisión de producto, datos, vendors y flujos. Mapa de riesgos y quick wins.</div>
        </div>
        <div class="step">
          <div class="step-title">2) Plan de adecuación</div>
          <div class="step-text">Roadmap, políticas, DPIA/PIA y medidas técnicas/organizativas.</div>
        </div>
        <div class="step">
          <div class="step-title">3) Implementación</div>
          <div class="step-text">Acompañamiento con equipos legal/tech y evidencias para auditoría.</div>
        </div>
      </div>

      <div class="final-cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
        <a class="btn ghost" href="/es/rgpd-ia">Ver RGPD & IA</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero{
    background: linear-gradient(180deg, #071A33 0%, #0A2446 100%);
    overflow: hidden;
  }

  .wrap{
    max-width: 1100px;
    margin: 0 auto;
    padding: 72px 20px 64px;
    color: #fff;
  }

  .topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
  }

  .brandbox{
    display:flex;
    align-items:center;
    gap:14px;
    background: rgba(255,255,255,0.95);
    border-radius: 22px;
    padding: 14px 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    color:#0f172a;
  }

  .brandlogo{
    height: 76px;
    width: auto;
    display:block;
  }

  .brandname{
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
  }

  .brandsub{
    font-size: 12px;
    color: #475569;
    margin-top: 2px;
  }

  .lang{
    font-size: 14px;
    display:flex;
    align-items:center;
    gap:8px;
    opacity: 0.95;
  }
  .lang a{ color:#fff; text-decoration:none; }
  .lang a:hover{ text-decoration:underline; }
  .lang .active{ font-weight:700; }
  .sep{ color: rgba(255,255,255,0.45); }

  .h1{
    margin-top: 38px;
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 700;
    max-width: 920px;
  }

  .lead{
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.6;
    max-width: 640px;
    color: rgba(255,255,255,0.88);
  }

  .cta{
    margin-top: 18px;
    display:flex;
    gap:12px;
    flex-wrap:wrap;
  }

  .btn{
    display:inline-block;
    padding: 10px 14px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 14px;
    text-decoration:none;
  }

  .primary{
    background:#fff;
    color:#071A33;
    box-shadow: 0 10px 26px rgba(0,0,0,.25);
  }

  .ghost{
    border: 1px solid rgba(255,255,255,.35);
    color:#fff;
    background: rgba(255,255,255,.08);
  }

  .btn:hover{
    transform: translateY(-1px);
  }

  .micro{
    margin-top: 10px;
    font-size: 13px;
    color: rgba(255,255,255,.78);
  }

  .cards{
    margin-top: 34px;
    display:grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 900px){
    .cards{ grid-template-columns: repeat(3, 1fr); }
    .h1{ font-size: 56px; }
  }

  .card{
    background: #fff;
    color: #0f172a;
    border-radius: 22px;
    padding: 18px 18px 16px;
    box-shadow: 0 14px 35px rgba(0,0,0,0.25);
  }

  .cardtitle{
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .cardtext{
    font-size: 14px;
    color: #334155;
    line-height: 1.55;
  }

  .contact{
    margin-top: 18px;
    font-size: 14px;
    color: rgba(255,255,255,0.85);
  }
  .contact a{
    color:#fff;
    text-decoration:underline;
    text-underline-offset: 3px;
  }

  /* TRUST BAR */
  .trust{
    background: #06162b;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .trust-wrap{
    max-width: 1100px;
    margin: 0 auto;
    padding: 14px 20px;
    display:flex;
    gap:16px;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    color: rgba(255,255,255,.85);
    font-size: 13px;
  }

  .trust-wrap strong{
    background: rgba(255,255,255,.1);
    padding: 6px 10px;
    border-radius: 10px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  /* HOW WE WORK */
  .how{
    background: #0A2446;
    color: #fff;
    padding: 56px 0;
  }

  .how-wrap{
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .how-h2{
    font-size: 28px;
    margin: 0;
  }

  .how-lead{
    margin-top: 10px;
    color: rgba(255,255,255,.85);
    max-width: 720px;
    line-height: 1.6;
  }

  .steps{
    margin-top: 22px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 900px){
    .steps{ grid-template-columns: repeat(3, 1fr); }
  }

  .step{
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 18px;
    padding: 16px;
  }

  .step-title{
    font-weight: 800;
    margin-bottom: 6px;
  }

  .step-text{
    color: rgba(255,255,255,.85);
    font-size: 14px;
    line-height: 1.55;
  }

  .final-cta{
    margin-top: 22px;
    display:flex;
    gap:12px;
    flex-wrap:wrap;
  }
</style>

