---
import Layout from "../../../layouts/Layout.astro";

const serviciosPrincipales = [
  {
    title: "Auditoría RGPD",
    price: "desde 490 €",
    bullets: [
      "Análisis de brechas y riesgos",
      "Revisión de documentación y proveedores",
      "Plan de adecuación priorizado"
    ]
  },
  {
    title: "Cumplimiento IA / AI Act",
    price: "desde 390 €",
    bullets: [
      "Clasificación del sistema según el AI Act",
      "Evaluación de riesgos y gobernanza",
      "Documentación técnica y medidas obligatorias"
    ]
  },
  {
    title: "Delegado de Protección de Datos (DPD externo)",
    price: "desde 90 €/mes",
    bullets: [
      "Supervisión continua",
      "Atención a interesados",
      "Informes y evidencias listas para auditoría"
    ]
  }
];

const complementarios = [
  "Evaluación de riesgos",
  "DPIA / PIA",
  "ISO 27001",
  "ENS (básico, medio y alto)",
  "Gestión de brechas de seguridad",
  "Transferencias internacionales y SCC",
  "Revisión de contratos y proveedores",
  "Políticas y documentación",
  "Formación interna"
];
---

<Layout title="Servicios RGPD & IA — CoverData">
  
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1 class="h1">Servicios RGPD & IA</h1>
      <p class="lead">
        Soluciones de cumplimiento diseñadas para startups y empresas tecnológicas que necesitan avanzar rápido sin comprometer la seguridad ni la legalidad.
      </p>

      <div class="cta">
        <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
      </div>
    </div>
  </section>

  <!-- PRINCIPALES -->
  <section class="wrap section">
    <h2 class="h2">Servicios principales</h2>

    <div class="cards">
      {serviciosPrincipales.map(s => (
        <div class="card">
          <div class="cardtitle">{s.title}</div>
          <div class="cardprice">{s.price}</div>

          <ul class="cardlist">
            {s.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- COMPLEMENTARIOS -->
  <section class="wrap section">
    <h2 class="h2">Servicios complementarios</h2>

    <ul class="list">
      {complementarios.map(item => <li>{item}</li>)}
    </ul>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-final">
    <div class="wrap">
      <h2 class="cta-title">¿Necesitas ayuda con RGPD o IA?</h2>
      <p class="cta-sub">Agenda una reunión de 30 minutos. Sin compromiso.</p>
      <a class="btn primary" href="/es/contacto">Solicitar diagnóstico gratuito</a>
    </div>
  </section>

</Layout>

<style>
/* HERO */
.hero{
  background: linear-gradient(180deg, #071A33 0%, #0A2446 100%);
  padding: 80px 0;
  color: #fff;
}
.wrap{
  max-width:1100px;
  margin:0 auto;
  padding:0 20px;
}
.h1{
  font-size:48px;
  font-weight:700;
  margin-bottom:16px;
}
.lead{
  max-width:640px;
  font-size:20px;
  color:rgba(255,255,255,.85);
  line-height:1.55;
}
.cta{
  margin-top:24px;
}
.btn{
  padding:12px 20px;
  border-radius:12px;
  font-weight:700;
  text-decoration:none;
  font-size:16px;
}
.primary{ background:#fff; color:#071A33; }

/* SECTIONS */
.section{
  padding:64px 0;
  color:#fff;
}
.h2{
  font-size:32px;
  font-weight:700;
  margin-bottom:24px;
}

/* CARDS */
.cards{
  display:grid;
  gap:20px;
}
@media(min-width:900px){
  .cards{ grid-template-columns:repeat(3,1fr); }
}
.card{
  background:#fff;
  color:#0f172a;
  padding:24px;
  border-radius:20px;
  box-shadow:0 6px 16px rgba(0,0,0,.12);
}
.cardtitle{
  font-size:20px;
  font-weight:700;
}
.cardprice{
  margin:6px 0 12px;
  font-weight:600;
  color:#0A2446;
}
.cardlist{
  margin-top:12px;
  line-height:1.55;
}

/* COMPLEMENTARIOS */
.list{
  line-height:1.7;
  font-size:18px;
}

/* CTA FINAL */
.cta-final{
  background:#071A33;
  padding:64px 0;
  text-align:center;
  color:#fff;
}
.cta-title{
  font-size:32px;
  font-weight:700;
}
.cta-sub{
  margin-top:8px;
  margin-bottom:20px;
  color:rgba(255,255,255,.85);
}
</style>

