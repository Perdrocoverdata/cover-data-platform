---
import Layout from "../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claimEN: "GDPR & AI Compliance for Tech Companies",
  claimES: "Consultoría Tech & Datos para empresas globales",
  subES:
    "Transformamos los datos de tu negocio en decisiones estratégicas y automatización eficiente.",
  email: "info@cover-data.com",
};
---

<Layout title="CoverData — GDPR & AI Compliance">
  <!-- HERO (banca / azul oscuro) -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#071A33] via-[#071A33] to-[#0A2446]"></div>
    <div class="absolute -top-24 -right-24 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>
    <div class="absolute -bottom-28 -left-28 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-6xl px-6 py-14 md:py-18">
      <!-- Header simple -->
      <header class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-4">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="h-60 md:h-64 w-auto" />
          <div class="leading-tight text-white">
            <div class="font-semibold text-xl">{brand.name}</div>
            <div class="text-xs text-white/75">{brand.claimEN}</div>
          </div>
        </a>

        <a
          href="#contact"
          class="rounded-xl bg-white px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-slate-100 transition"
        >
          Contactar
        </a>
      </header>

      <div class="mt-12 grid gap-10 md:grid-cols-2 md:items-center">
        <div class="text-white">
          <p class="text-sm text-white/80">Consultoría internacional · RGPD · IA · Tech</p>

          <h1 class="mt-3 text-4xl md:text-5xl font-semibold tracking-tight">
            {brand.claimES}
          </h1>

          <p class="mt-5 text-lg text-white/85">{brand.subES}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#contact"
              class="rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100 transition"
            >
              Consulta inicial gratuita
            </a>
            <a
              href="#offers"
              class="rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition"
            >
              Ver ofertas
            </a>
          </div>

          <div class="mt-6 text-sm text-white/70">
            Especialización: <span class="font-semibold">GDPR & AI Compliance</span> para empresas tecnológicas que operan o venden en Europa.
          </div>
        </div>

        <div class="rounded-3xl bg-white/95 p-8 shadow-sm border border-white/30">
          <div class="text-sm font-semibold text-slate-900">Qué obtienes en CoverData</div>
          <ul class="mt-4 space-y-3 text-slate-700 text-sm">
            <li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-slate-900"></span>Diagnóstico claro de riesgos (sin burocracia)</li>
            <li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-slate-900"></span>Recomendaciones RGPD + Reglamento Europeo de IA</li>
            <li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-slate-900"></span>Roadmap accionable para equipo y producto</li>
          </ul>

          <div class="mt-6 rounded-2xl bg-slate-50 p-4 border border-slate-200">
            <div class="text-xs text-slate-500">Contacto</div>
            <div class="font-semibold text-slate-900">{brand.email}</div>
          </div>
        </div>
      </div>

      <!-- 3 cards flotantes -->
      <div id="services" class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl bg-white p-7 shadow-sm border border-slate-200">
          <div class="text-xs font-semibold text-slate-500">Servicio 01</div>
          <h3 class="mt-2 text-lg font-semibold">Auditoría RGPD & Data Risk</h3>
          <p class="mt-2 text-sm text-slate-700">
            Auditoría práctica enfocada a riesgos reales: flujos de datos, proveedores y contratos.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-7 shadow-sm border border-slate-200">
          <div class="text-xs font-semibold text-slate-500">Servicio 02</div>
          <h3 class="mt-2 text-lg font-semibold">Cumplimiento en IA</h3>
          <p class="mt-2 text-sm text-slate-700">
            Evaluación de sistemas de IA conforme a RGPD y AI Act con estrategias claras de mitigación.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-7 shadow-sm border border-slate-200">
          <div class="text-xs font-semibold text-slate-500">Servicio 03</div>
          <h3 class="mt-2 text-lg font-semibold">EU Market Readiness</h3>
          <p class="mt-2 text-sm text-slate-700">
            Pack para startups SaaS internacionales que quieren vender en Europa (DPA, vendors, docs).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- “Protección por diseño y por defecto” -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-14">
      <div class="rounded-3xl bg-slate-50 border border-slate-200 p-8 md:p-10">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
          Protección de datos por diseño y por defecto
        </h2>
        <p class="mt-3 text-slate-700 max-w-3xl">
          Integramos el cumplimiento en el producto desde el inicio: minimización de datos, controles de acceso,
          privacidad en arquitecturas cloud y gobernanza para IA. Menos riesgo, más confianza y mejor venta enterprise.
        </p>

        <div class="mt-8 grid gap-6 md:grid-cols-3">
          <div class="rounded-2xl bg-white border border-slate-200 p-6">
            <div class="text-sm font-semibold">Minimización & Retención</div>
            <p class="mt-2 text-sm text-slate-700">
              Recogida mínima, periodos de retención y borrado automatizado.
            </p>
          </div>
          <div class="rounded-2xl bg-white border border-slate-200 p-6">
            <div class="text-sm font-semibold">Arquitectura segura</div>
            <p class="mt-2 text-sm text-slate-700">
              Accesos, cifrado, logging y separación de entornos cloud.
            </p>
          </div>
          <div class="rounded-2xl bg-white border border-slate-200 p-6">
            <div class="text-sm font-semibold">IA responsable</div>
            <p class="mt-2 text-sm text-slate-700">
              Evaluación de riesgos, DPIA cuando aplica y políticas internas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OFFERS (3 cuadros azul banca) -->
  <section id="offers" class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-10">
        <h2 class="text-3xl font-semibold tracking-tight">Ofertas principales</h2>
        <p class="mt-2 text-slate-700">Comienza con una auditoría y escala cuando lo necesites.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl p-7 text-white shadow-sm bg-[#071A33]">
          <div class="text-sm text-white/80">5 horas</div>
          <div class="mt-2 text-xl font-semibold">Auditoría RGPD Inicial</div>
          <div class="mt-4 text-4xl font-semibold">500 €</div>
          <ul class="mt-6 space-y-2 text-sm text-white/90">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Revisión de flujos</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Riesgos prioritarios</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Plan de acción</li>
          </ul>
          <a href="#contact" class="mt-7 inline-flex w-full items-center justify-center rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100 transition">
            Reservar
          </a>
        </div>

        <div class="rounded-3xl p-7 text-white shadow-sm bg-[#0A2446]">
          <div class="text-sm text-white/80">SaaS internacionales</div>
          <div class="mt-2 text-xl font-semibold">RGPD Ready for Europe</div>
          <div class="mt-4 text-4xl font-semibold">1.800 €</div>
          <ul class="mt-6 space-y-2 text-sm text-white/90">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Pack comercial EU</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>DPAs + vendors</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Docs enterprise</li>
          </ul>
          <a href="#contact" class="mt-7 inline-flex w-full items-center justify-center rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100 transition">
            Solicitar info
          </a>
        </div>

        <div class="rounded-3xl p-7 text-white shadow-sm bg-[#071A33]">
          <div class="text-sm text-white/80">RGPD + AI Act</div>
          <div class="mt-2 text-xl font-semibold">AI Compliance Pack</div>
          <div class="mt-4 text-4xl font-semibold">Desde 1.200 €</div>
          <ul class="mt-6 space-y-2 text-sm text-white/90">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Risk assessment</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Mapa regulatorio</li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 rounded-full bg-white"></span>Roadmap equipo/producto</li>
          </ul>
          <a href="#contact" class="mt-7 inline-flex w-full items-center justify-center rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100 transition">
            Evaluar proyecto
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight">Contacto</h2>
          <p class="mt-3 text-slate-700">
            Escríbenos a <strong>{brand.email}</strong> o solicita una consulta inicial gratuita.
          </p>
          <p class="mt-4 text-sm text-slate-600">Respuesta habitual: 24h laborables.</p>
        </div>

        <form name="contact" method="POST" data-netlify="true" class="rounded-3xl border border-slate-200 bg-white p-7">
          <input type="hidden" name="form-name" value="contact" />
          <label class="block text-sm font-semibold">Nombre</label>
          <input name="name" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" />
          <label class="mt-4 block text-sm font-semibold">Email</label>
          <input type="email" name="email" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" />
          <label class="mt-4 block text-sm font-semibold">Mensaje</label>
          <textarea name="message" rows="5" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3"></textarea>
          <button type="submit" class="mt-5 inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800 transition">
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>

  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-slate-600 flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
      <div>© {new Date().getFullYear()} CoverData</div>
      <div class="flex gap-4">
        <a class="underline" href="/privacy">Privacy Policy</a>
        <a class="underline" href="/legal">Legal Notice</a>
        <a class="underline" href="/cookies">Cookies</a>
      </div>
    </div>
  </footer>
</Layout>
