---
// CoverData – Home (clean + minimal)
const brand = {
  name: "CoverData",
  claim: "GDPR & AI Compliance for Tech Companies",
  email: "info@cover-data.com",
  cta: "Free initial consultation",
};

const offers = [
  {
    title: "Initial GDPR Audit",
    price: "€500",
    subtitle: "5 hours",
    bullets: [
      "Data flows review",
      "Risk prioritisation",
      "Actionable roadmap",
    ],
    cta: "Book the audit",
  },
  {
    title: "GDPR Ready for Europe",
    price: "€1,800",
    subtitle: "For SaaS & startups",
    bullets: [
      "EU market readiness",
      "DPAs & vendor review",
      "Enterprise compliance pack",
    ],
    cta: "Request details",
  },
  {
    title: "AI Compliance Pack",
    price: "From €1,200",
    subtitle: "GDPR + EU AI Act",
    bullets: [
      "AI risk assessment",
      "Regulatory mapping",
      "Compliance roadmap",
    ],
    cta: "Evaluate project",
  },
];
---

<html lang="en">
  <body class="bg-white text-slate-900 antialiased">
    <header class="border-b border-slate-200">
      <div class="mx-auto max-w-6xl px-6 py-5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <img src="/logo.svg" alt="CoverData logo" class="h-9 w-9" />
          <div>
            <div class="font-semibold text-lg">{brand.name}</div>
            <div class="text-xs text-slate-600">{brand.claim}</div>
          </div>
        </div>
        <a href="#contact" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">
          {brand.cta}
        </a>
      </div>
    </header>

    <main>
      <section class="mx-auto max-w-6xl px-6 py-14 text-center">
        <h1 class="text-4xl md:text-5xl font-semibold">{brand.claim}</h1>
        <p class="mt-4 text-lg text-slate-700">
          Practical compliance for SaaS, startups and AI-driven companies operating in Europe.
        </p>
        <a href="#pricing" class="mt-6 inline-block rounded-xl bg-slate-900 px-6 py-3 text-white">
          View pricing
        </a>
      </section>

      <section id="pricing" class="mx-auto max-w-6xl px-6 py-14">
        <div class="grid gap-6 md:grid-cols-3">
          {offers.map((o) => (
            <div class="rounded-3xl bg-slate-900 text-white p-7">
              <div class="text-sm text-white/80">{o.subtitle}</div>
              <div class="mt-2 text-xl font-semibold">{o.title}</div>
              <div class="mt-4 text-4xl font-semibold">{o.price}</div>

              <ul class="mt-6 space-y-2 text-sm">
                {o.bullets.map((b) => (
                  <li class="flex gap-2">
                    <span class="h-2 w-2 mt-1 rounded-full bg-white"></span>
                    {b}
                  </li>
                ))}
              </ul>

              <a href="#contact" class="mt-7 block rounded-xl bg-white text-slate-900 text-center py-3">
                {o.cta}
              </a>
            </div>
          ))}
        </div>
      </section>

      <section id="contact" class="mx-auto max-w-6xl px-6 py-14">
        <h2 class="text-3xl font-semibold">Contact</h2>
        <p class="mt-2">
          Email us at <strong>{brand.email}</strong> or book a free consultation.
        </p>
      </section>
    </main>
  </body>
</html>
