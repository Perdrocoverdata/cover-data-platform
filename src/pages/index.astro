---
const brand = {
  name: "CoverData",
  claim: "GDPR & AI Compliance for Tech Companies",
  email: "info@cover-data.com",
  cta: "Free initial consultation",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CoverData – GDPR & AI Compliance</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="CoverData is a consultancy specialised in GDPR, AI and data protection compliance for tech companies operating in Europe."
    />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
          Segoe UI, Roboto, Arial, sans-serif;
      }
    </style>
  </head>

  <body class="bg-white text-slate-900">
    <!-- HEADER -->
    <header class="border-b border-slate-200">
      <div
        class="mx-auto max-w-6xl px-6 py-5 flex items-center justify-between"
      >
        <div class="flex items-center gap-3">
          <img
            src="/coverdata-logo.png"
            alt="CoverData logo"
            class="h-10 w-auto"
          />
          <div>
            <div class="font-semibold text-lg">{brand.name}</div>
            <div class="text-xs text-slate-600">{brand.claim}</div>
          </div>
        </div>

        <a
          href="#contact"
          class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
        >
          {brand.cta}
        </a>
      </div>
    </header>

    <!-- HERO -->
    <section class="mx-auto max-w-6xl px-6 py-16 text-center">
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">
        GDPR & AI Compliance for Tech Companies
      </h1>
      <p class="mt-5 text-lg text-slate-700">
        We help SaaS, startups and AI-driven businesses comply with European data
        protection and AI regulation — clearly, efficiently and with business
        focus.
      </p>

      <div class="mt-8 flex justify-center gap-4">
        <a
          href="#services"
          class="rounded-xl bg-slate-900 px-6 py-3 text-white font-semibold hover:bg-slate-800"
        >
          Our services
        </a>
        <a
          href="#contact"
          class="rounded-xl border border-slate-300 px-6 py-3 font-semibold text-slate-900 hover:bg-slate-50"
        >
          {brand.cta}
        </a>
      </div>
    </section>

    <!-- SERVICES (3 CARDS) -->
    <section id="services" class="bg-slate-50 py-16">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-3xl font-semibold text-center">
          Our core services
        </h2>
        <p class="mt-3 text-center text-slate-700">
          Compliance solutions designed for modern technology companies.
        </p>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          <div
            class="rounded-3xl bg-white border border-slate-200 p-7 shadow-sm"
          >
            <h3 class="font-semibold text-lg">
              GDPR & Data Protection Audits
            </h3>
            <p class="mt-3 text-slate-700">
              Practical GDPR audits focused on real operational risks, data
              flows, vendors and contracts.
            </p>
            <p class="mt-4 text-sm text-slate-500">
              Ideal for SaaS and digital services.
            </p>
          </div>

          <div
            class="rounded-3xl bg-white border border-slate-200 p-7 shadow-sm"
          >
            <h3 class="font-semibold text-lg">
              AI Compliance & Risk Assessment
            </h3>
            <p class="mt-3 text-slate-700">
              Evaluation of AI systems under GDPR and the EU AI Act with clear
              risk and compliance strategies.
            </p>
            <p class="mt-4 text-sm text-slate-500">
              Ideal for AI startups and data-driven products.
            </p>
          </div>

          <div
            class="rounded-3xl bg-white border border-slate-200 p-7 shadow-sm"
          >
            <h3 class="font-semibold text-lg">
              EU Market Readiness
            </h3>
            <p class="mt-3 text-slate-700">
              Compliance frameworks to help international tech companies sell
              and operate legally in Europe.
            </p>
            <p class="mt-4 text-sm text-slate-500">
              Ideal for global SaaS companies.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="text-3xl font-semibold">Contact CoverData</h2>
      <p class="mt-3 text-slate-700">
        Book a free initial consultation or write to us at
        <strong>{brand.email}</strong>.
      </p>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        class="mt-8 max-w-xl border border-slate-200 rounded-3xl p-7"
      >
        <input type="hidden" name="form-name" value="contact" />

        <label class="block font-semibold text-sm">Name</label>
        <input
          name="name"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3"
        />

        <label class="mt-4 block font-semibold text-sm">Email</label>
        <input
          type="email"
          name="email"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3"
        />

        <label class="mt-4 block font-semibold text-sm">Message</label>
        <textarea
          name="message"
          rows="5"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3"
        ></textarea>

        <button
          type="submit"
          class="mt-5 w-full rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white hover:bg-slate-800"
        >
          Send message
        </button>
      </form>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-slate-200 py-8">
      <div
        class="mx-auto max-w-6xl px-6 text-sm text-slate-600 flex justify-between"
      >
        <div>© {new Date().getFullYear()} CoverData</div>
        <div class="flex gap-4">
          <a href="/privacy" class="underline">Privacy Policy</a>
          <a href="/legal" class="underline">Legal Notice</a>
          <a href="/cookies" class="underline">Cookies</a>
        </div>
      </div>
    </footer>
  </body>
</html>

