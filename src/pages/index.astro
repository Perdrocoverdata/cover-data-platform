---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "Consultoría Tech & Datos para empresas globales",
  sub: "Ayudamos a empresas tecnológicas a operar de forma segura y conforme al RGPD en Europa.",
  email: "info@cover-data.com",
};
---

<Layout title="CoverData — Consultoría RGPD & IA">
  <section class="relative overflow-hidden bg-gradient-to-b from-[#071A33] to-[#0A2446]">
    <div class="mx-auto max-w-6xl px-6 pt-24 pb-20 text-white">
      <header class="flex items-center justify-between">
        <div class="flex items-center gap-4 bg-white/95 px-6 py-4 rounded-3xl shadow-md">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="h-20 md:h-24 w-auto" />
          <div>
            <div class="text-xl font-semibold text-slate-900">{brand.name}</div>
            <div class="text-xs text-slate-600">GDPR & AI Compliance</div>
          </div>
        </div>

        <div class="flex gap-2 text-sm">
          <a href="/es/" class="text-white font-semibold">ES</a>
          <span class="text-white/40">|</span>
          <a href="/en/" class="text-white/80 hover:text-white">EN</a>
        </div>
      </header>

      <h1 class="mt-14 text-4xl md:text-6xl font-semibold tracking-tight">{brand.claim}</h1>
      <p class="mt-6 text-lg md:text-xl max-w-xl text-white/90">{brand.sub}</p>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="bg-white rounded-3xl p-6 text-slate-800 shadow">Auditoría RGPD</div>
        <div class="bg-white rounded-3xl p-6 text-slate-800 shadow">Cumplimiento IA</div>
        <div class="bg-white rounded-3xl p-6 text-slate-800 shadow">Expansión UE</div>
      </div>

      <div class="mt-10 text-sm text-white/80">
        Contacto: <a class="underline" href="mailto:info@cover-data.com">info@cover-data.com</a>
      </div>
    </div>
  </section>
</Layout>

