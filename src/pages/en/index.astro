---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "GDPR & AI compliance for tech companies",
  sub: "We help technology-driven businesses comply with GDPR and reduce legal risks in data- and AI-based products, enabling secure operations and growth in Europe.",
  email: "info@cover-data.com",
};
---

<Layout title="CoverData — GDPR & AI Compliance Consulting">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <header class="topbar">
        <div class="brandbox">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="brandlogo" />
          <div class="brandtext">
            <div class="brandname">{brand.name}</div>
            <div class="brandsub">GDPR & AI Compliance</div>
          </div>
        </div>

        <div class="lang">
          <a href="/es/">ES</a>
          <span class="sep">|</span>
          <a href="/en/" class="active">EN</a>
        </div>
      </header>

      <h1 class="h1">{brand.claim}</h1>
      <p class="lead">{brand.sub}</p>

      <!-- CTA -->
      <div class="cta">
        <a class="btn primary" href="/en/contact">Request a free assessment</a>
        <a class="btn ghost" href="/en/gdpr-ai">View GDPR & AI services</a>
      </div>

      <p class="micro">30 minutes • No commitment • 100% confidential</p>

      <!-- SERVICES -->
      <div class="cards">
        <div class="card">
          <div class="cardtitle">GDPR Audit & Risk Assessment</div>
          <div class="cardtext">Gap analysis, risk evaluation and a compliance roadmap for digital products.</div>
        </div>

        <div class="card">
          <div class="cardtitle">AI Compliance & Governance</div>
          <div class="cardtext">DPIA, privacy by design and AI governance aligned with EU regulations.</div>
        </div>

        <div class="card">
          <div class="cardtitle">EU Market Expansion</div>
          <div class="cardtext">International transfers, SCCs and vendor compliance management.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust">
    <div class="trust-wrap">
      <span>European regulatory framework:</span>
      <strong>GDPR</strong>
      <strong>Spanish Data Protection Law</strong>
      <strong>EU AI Act</strong>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="how">
    <div class="how-wrap">
      <h2 class="how-h2">How we work</h2>
      <p class="how-lead">
        Practical, documented and business-aligned: we reduce risk without slowing down product teams.
      </p>

      <div class="steps">
        <div class="step">
          <div class="step-title">1) Assessment</div>
          <div class="step-text">Review product, data flows, vendors and risks. Quick wins included.</div>
        </div>
        <div class="step">
          <div class="step-title">2) Compliance roadmap</div>
          <div class="step-text">Plan, policies, DPIA/PIA and technical/organisational measures.</div>
        </div>
        <div class="step">
          <div class="step-title">3) Implementation support</div>
          <div class="step-text">Hands-on support with legal/tech teams and audit-ready evidence.</div>
        </div>
      </div>

      <div class="final-cta">
        <a class="btn primary" href="/en/contact">Request a free assessment</a>
        <a class="btn ghost" href="/en/gdpr-ai">View GDPR & AI services</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero{
    background: linear-gradient(180deg, #071A33 0%, #0A2446 100%);
    overflow: hidden;
  }

  .wrap{
    max-width: 1100px;
    margin: 0 auto;
    padding: 72px 20px 64px;
    color: #fff;
  }

  .topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
  }

  .brandbox{
    display:flex;
    align-items:center;
    gap:14px;
    background: rgba(255,255,255,0.95);
    border-radius: 22px;
    padding: 14px 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    color:#0f172a;
  }

  .brandlogo{
    height: 76px;
    width: auto;
    display:block;
  }

  .brandname{
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
  }

  .brandsub{
    font-size: 12px;
    color: #475569;
    margin-top: 2px;
  }

  .lang{
    font-size: 14px;
    display:flex;
    align-items:center;
    gap:8px;
    opacity: 0.95;
  }
  .lang a{ color:#fff; text-decoration:none; }
  .lang a:hover{ text-decoration:underline; }
  .lang .active{ font-weight:700; }
  .sep{ color: rgba(255,255,255,0.45); }

  .h1{
    margin-top: 38px;
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 700;
    max-width: 920px;
  }

  .lead{
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.6;
    max-width: 640px;
    color: rgba(255,255,255,0.88);
  }

  .cta{
    margin-top: 18px;
    display:flex;
    gap:12px;
    flex-wrap:wrap;
  }

  .btn{
    display:inline-block;
    padding: 10px 14px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 14px;
    text-decoration:none;
  }

  .primary{
    background:#fff;
    color:#071A33;
    box-shadow: 0 10px 26px rgba(0,0,0,.25);
  }

  .ghost{
    border: 1px solid rgba(255,255,255,.35);
    color:#fff;
    background: rgba(255,255,255,.08);
  }

  .btn:hover{
    transform: translateY(-1px);
  }

  .micro{
    margin-top: 10px;
    font-size: 13px;
    color: rgba(255,255,255,.78);
  }

  .cards{
    margin-top: 34px;
    display:grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 900px){
    .cards{ grid-template-columns: repeat(3, 1fr); }
    .h1{ font-size: 56px; }
  }

  .card{
    background: #fff;
    color: #0f172a;
    border-radius: 22px;
    padding: 18px 18px 16px;
    box-shadow: 0 14px 35px rgba(0,0,0,0.25);
  }

  .cardtitle{
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .cardtext{
    font-size: 14px;
    color: #334155;
    line-height: 1.55;
  }

  /* TRUST BAR */
  .trust{
    background: #06162b;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .trust-wrap{
    max-width: 1100px;
    margin: 0 auto;
    padding: 14px 20px;
    display:flex;
    gap:16px;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    color: rgba(255,255,255,.85);
    font-size: 13px;
  }

  .trust-wrap strong{
    background: rgba(255,255,255,.1);
    padding: 6px 10px;
    border-radius: 10px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  /* HOW WE WORK */
  .how{
    background: #0A2446;
    color: #fff;
    padding: 56px 0;
  }

  .how-wrap{
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .how-h2{
    font-size: 28px;
    margin: 0;
  }

  .how-lead{
    margin-top: 10px;
    color: rgba(255,255,255,.85);
    max-width: 720px;
    line-height: 1.6;
  }

  .steps{
    margin-top: 22px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 900px){
    .steps{ grid-template-columns: repeat(3, 1fr); }
  }

  .step{
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 18px;
    padding: 16px;
  }

  .step-title{
    font-weight: 800;
    margin-bottom: 6px;
  }

  .step-text{
    color: rgba(255,255,255,.85);
    font-size: 14px;
    line-height: 1.55;
  }

  .final-cta{
    margin-top: 22px;
    display:flex;
    gap:12px;
    flex-wrap:wrap;
  }
</style>


