---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "GDPR & AI Compliance for Tech Companies",
  sub: "We help startups and technology companies comply with GDPR and the EU AI Act, reducing legal risks and accelerating their growth in Europe."
};

const services = [
  {
    title: "GDPR Audit",
    text: "Risk assessment, gap analysis and compliance roadmap."
  },
  {
    title: "AI Compliance",
    text: "Privacy by design, DPIA and AI governance."
  },
  {
    title: "EU Expansion",
    text: "International transfers, SCCs and vendor management."
  }
];

const steps = [
  {
    title: "1) Assessment",
    text: "Review of product, data flows and vendors. Identification of risks and quick wins."
  },
  {
    title: "2) Compliance plan",
    text: "Legal roadmap, policies, DPIA/PIA and technical & organizational measures."
  },
  {
    title: "3) Implementation",
    text: "Support for legal and technical teams with audit‑ready evidence."
  }
];

const reasons = [
  "Specialists in startups and tech companies",
  "Compliance without slowing down innovation",
  "Audit‑ready documentation",
  "Legal + technical support",
  "Transparent pricing",
  "Fast response and ongoing support"
];
---

<Layout title="CoverData — GDPR & AI Compliance">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <header class="topbar">
        <div class="brandbox">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="brandlogo" />
          <div class="brandtext">
            <div class="brandname">{brand.name}</div>
            <div class="brandsub">GDPR & AI Compliance</div>
          </div>
        </div>

        <div class="lang">
          <a href="/es/">ES</a>
          <span class="sep">|</span>
          <a href="/en/" class="active">EN</a>
        </div>
      </header>

      <h1 class="h1">{brand.claim}</h1>
      <p class="lead">{brand.sub}</p>

      <div class="cta">
        <a class="btn primary" href="/en/contact">Request a free assessment</a>
        <a class="btn ghost" href="/en/gdpr-ai">View GDPR & AI services</a>
      </div>

      <p class="micro">30 minutes • No commitment • 100% confidential</p>

      <!-- SERVICES -->
      <div class="cards">
        {services.map(s => (
          <div class="card">
            <div class="cardtitle">{s.title}</div>
            <div class="cardtext">{s.text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust">
    <div class="trust-wrap">
      <span>European regulatory framework:</span>
      <strong>GDPR</strong>
      <strong>LOPDGDD</strong>
      <strong>AI Act</strong>
    </div>
  </section>

  <!-- HOW -->
  <section class="how">
    <div class="how-wrap">
      <h2 class="how-h2">How we work</h2>
      <p class="how-lead">
        A practical, business‑aligned approach: we reduce legal risks without slowing down innovation or product development.
      </p>

      <div class="steps">
        {steps.map(step => (
          <div class="step">
            <div class="step-title">{step.title}</div>
            <div class="step-text">{step.text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why">
    <div class="why-wrap">
      <h2 class="why-h2">Why choose us</h2>

      <ul class="why-list">
        {reasons.map(r => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-final">
    <div class="cta-wrap">
      <h2 class="cta-title">Need help with GDPR or AI compliance?</h2>
      <p class="cta-sub">Book a 30‑minute meeting. No commitment.</p>
      <a class="btn primary" href="/en/contact">Request a free assessment</a>
    </div>
  </section>

</Layout>

<style>
/* GENERAL */
:root{
  --primary:#071A33;
  --secondary:#0A2446;
  --accent:#1EC6D7;
  --accent2:#7A5FFF;
}

.hero{
  background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
  padding: 100px 0 80px;
  color: #fff;
}

.wrap{
  max-width:1200px;
  margin:0 auto;
  padding:0 24px;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:48px;
}

.brandbox{
  display:flex;
  align-items:center;
  gap:20px;
}

.brandlogo{
  height:120px;
}

.brandname{
  font-size:30px;
  font-weight:800;
}

.brandsub{
  font-size:15px;
  opacity:.85;
}

.lang a{
  color:#fff;
  text-decoration:none;
  font-size:16px;
}
.lang .active{
  font-weight:700;
  color:var(--accent);
}

.h1{
  font-size:54px;
  font-weight:800;
  margin-bottom:20px;
  max-width:800px;
}

.lead{
  max-width:700px;
  font-size:22px;
  color:rgba(255,255,255,.9);
  line-height:1.6;
}

.cta{
  margin-top:32px;
  display:flex;
  gap:16px;
}

.btn{
  padding:14px 24px;
  border-radius:14px;
  font-weight:700;
  text-decoration:none;
  font-size:17px;
}

.primary{ 
  background:#fff; 
  color:var(--primary); 
}

.ghost{ 
  border:2px solid var(--accent); 
  color:var(--accent); 
}

.micro{
  margin-top:16px;
  font-size:15px;
  opacity:.85;
}

/* SERVICES */
.cards{
  margin-top:48px;
  display:grid;
  gap:24px;
}

@media(min-width:900px){
  .cards{ grid-template-columns:repeat(3,1fr); }
}

.card{
  background:#fff;
  color:#0f172a;
  padding:32px;
  border-radius:24px;
  border:3px solid var(--accent2);
  box-shadow:0 8px 20px rgba(0,0,0,.12);
  transition:transform .2s ease, box-shadow .2s ease;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:0 12px 28px rgba(0,0,0,.18);
}

.cardtitle{
  font-size:22px;
  font-weight:800;
  color:var(--primary);
}

.cardtext{
  margin-top:10px;
  line-height:1.6;
  font-size:17px;
}

/* TRUST */
.trust{
  background:#fff;
  padding:48px 0;
  text-align:center;
  border-top:4px solid var(--accent);
  border-bottom:4px solid var(--accent2);
}

.trust-wrap strong{
  margin:0 10px;
  font-size:18px;
  color:var(--primary);
}

/* HOW */
.how{
  padding:80px 0;
  background:#f4f8ff;
}

.how-h2{
  font-size:36px;
  font-weight:800;
  color:var(--primary);
}

.how-lead{
  margin-top:16px;
  max-width:650px;
  line-height:1.7;
  font-size:19px;
}

.steps{
  margin-top:40px;
  display:grid;
  gap:24px;
}

.step{
  background:#fff;
  padding:28px;
  border-radius:20px;
  border-left:6px solid var(--accent);
  box-shadow:0 6px 16px rgba(0,0,0,.1);
}

.step-title{
  font-size:22px;
  font-weight:700;
  color:var(--primary);
}

.step-text{
  margin-top:10px;
  line-height:1.6;
  font-size:17px;
}

/* WHY */
.why{
  padding:80px 0;
}

.why-h2{
  font-size:36px;
  font-weight:800;
  color:var(--primary);
}

.why-list{
  margin-top:24px;
  line-height:1.8;
  font-size:19px;
  max-width:700px;
}

/* CTA FINAL */
.cta-final{
  background:var(--primary);
  padding:80px 0;
  text-align:center;
  color:#fff;
  border-top:6px solid var(--accent);
}

.cta-title{
  font-size:36px;
  font-weight:800;
}

.cta-sub{
  margin-top:12px;
  margin-bottom:28px;
  color:rgba(255,255,255,.85);
}
</style>

