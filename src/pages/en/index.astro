/* GENERAL */
:root{
  --primary:#071A33;
  --secondary:#0A2446;
  --accent:#1EC6D7;      /* Turquesa elegante */
  --accent2:#7A5FFF;     /* Morado suave */
}

.hero{
  background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
  padding: 100px 0 80px;
  color: #fff;
}

.wrap{
  max-width:1200px;
  margin:0 auto;
  padding:0 24px;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:48px;
}

.brandbox{
  display:flex;
  align-items:center;
  gap:20px;
}

.brandlogo{
  height:120px;
}

.brandname{
  font-size:30px;
  font-weight:800;
}

.brandsub{
  font-size:15px;
  opacity:.85;
}

.lang a{
  color:#fff;
  text-decoration:none;
  font-size:16px;
}
.lang .active{
  font-weight:700;
  color:var(--accent);
}

.h1{
  font-size:54px;
  font-weight:800;
  margin-bottom:20px;
  max-width:800px;
}

.lead{
  max-width:700px;
  font-size:22px;
  color:rgba(255,255,255,.9);
  line-height:1.6;
}

.cta{
  margin-top:32px;
  display:flex;
  gap:16px;
}

.btn{
  padding:14px 24px;
  border-radius:14px;
  font-weight:700;
  text-decoration:none;
  font-size:17px;
}

.primary{ 
  background:#fff; 
  color:var(--primary); 
}

.ghost{ 
  border:2px solid var(--accent); 
  color:var(--accent); 
}

.micro{
  margin-top:16px;
  font-size:15px;
  opacity:.85;
}

/* SERVICES */
.cards{
  margin-top:48px;
  display:grid;
  gap:24px;
}

@media(min-width:900px){
  .cards{ grid-template-columns:repeat(3,1fr); }
}

.card{
  background:#fff;
  color:#0f172a;
  padding:32px;
  border-radius:24px;
  border:3px solid var(--accent2);
  box-shadow:0 8px 20px rgba(0,0,0,.12);
  transition:transform .2s ease, box-shadow .2s ease;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:0 12px 28px rgba(0,0,0,.18);
}

.cardtitle{
  font-size:22px;
  font-weight:800;
  color:var(--primary);
}

.cardtext{
  margin-top:10px;
  line-height:1.6;
  font-size:17px;
}

/* TRUST */
.trust{
  background:#fff;
  padding:48px 0;
  text-align:center;
  border-top:4px solid var(--accent);
  border-bottom:4px solid var(--accent2);
}

.trust-wrap strong{
  margin:0 10px;
  font-size:18px;
  color:var(--primary);
}

/* HOW */
.how{
  padding:80px 0;
  background:#f4f8ff;
}

.how-h2{
  font-size:36px;
  font-weight:800;
  color:var(--primary);
}

.how-lead{
  margin-top:16px;
  max-width:650px;
  line-height:1.7;
  font-size:19px;
}

.steps{
  margin-top:40px;
  display:grid;
  gap:24px;
}

.step{
  background:#fff;
  padding:28px;
  border-radius:20px;
  border-left:6px solid var(--accent);
  box-shadow:0 6px 16px rgba(0,0,0,.1);
}

.step-title{
  font-size:22px;
  font-weight:700;
  color:var(--primary);
}

.step-text{
  margin-top:10px;
  line-height:1.6;
  font-size:17px;
}

/* WHY */
.why{
  padding:80px 0;
}

.why-h2{
  font-size:36px;
  font-weight:800;
  color:var(--primary);
}

.why-list{
  margin-top:24px;
  line-height:1.8;
  font-size:19px;
  max-width:700px;
}

/* CTA FINAL */
.cta-final{
  background:var(--primary);
  padding:80px 0;
  text-align:center;
  color:#fff;
  border-top:6px solid var(--accent);
}

.cta-title{
  font-size:36px;
  font-weight:800;
}

.cta-sub{
  margin-top:12px;
  margin-bottom:28px;
  color:rgba(255,255,255,.85);
}
