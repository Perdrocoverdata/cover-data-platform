---
import Layout from "../../layouts/Layout.astro";

const brand = {
  name: "CoverData",
  claim: "GDPR & AI compliance for tech companies",
  sub: "We help tech companies comply with GDPR and EU AI regulations, reducing legal risk and enabling secure growth in Europe.",
};
---

<Layout title="CoverData — GDPR & AI Compliance Consulting">
  <section class="hero">
    <div class="wrap">
      <header class="topbar">
        <div class="brandbox">
          <img src="/coverdata-logo.png" alt="CoverData logo" class="brandlogo" />
          <div class="brandtext">
            <div class="brandname">{brand.name}</div>
            <div class="brandsub">GDPR & AI Compliance</div>
          </div>
        </div>

        <div class="lang">
          <a href="/es/">ES</a>
          <span class="sep">|</span>
          <a href="/en/" class="active">EN</a>
        </div>
      </header>

      <h1 class="h1">{brand.claim}</h1>
      <p class="lead">{brand.sub}</p>

      <div class="cta">
        <a class="btn primary" href="/en/contact">Request a free assessment</a>
        <a class="btn ghost" href="/en/gdpr-ai">View GDPR & AI services</a>
      </div>

      <p class="micro">30 minutes • No commitment • 100% confidential</p>

      <div class="cards">
        <div class="card">
          <div class="cardtitle">GDPR Audit</div>
          <div class="cardtext">
            Compliance gap analysis and legal risk assessment.
          </div>
        </div>

        <div class="card">
          <div class="cardtitle">AI Compliance</div>
          <div class="cardtext">
            DPIA, privacy by design and AI governance aligned with EU law.
          </div>
        </div>

        <div class="card">
          <div class="cardtitle">EU Market Expansion</div>
          <div class="cardtext">
            International data transfers, SCCs and vendor compliance.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust-wrap">
      <span>European regulatory framework:</span>
      <strong>GDPR</strong>
      <strong>EU AI Act</strong>
    </div>
  </section>

  <section class="how">
    <div class="how-wrap">
      <h2 class="how-h2">How we work</h2>
      <p class="how-lead">
        Practical and business-aligned: we reduce legal risk without slowing down product teams.
      </p>

      <div class="steps">
        <div class="step">
          <div class="step-title">1) Assessment</div>
          <div class="step-text">
            Review of product, data flows, vendors and risk areas.
          </div>
        </div>
        <div class="step">
          <div class="step-title">2) Compliance roadmap</div>
          <div class="step-text">
            Policies, DPIA/PIA and technical and organisational measures.
          </div>
        </div>
        <div class="step">
          <div class="step-title">3) Implementation support</div>
          <div class="step-text">
            Hands-on support with legal and technical teams, audit-ready documentation.
          </div>
        </div>
      </div>

      <div class="final-cta">
        <a class="btn primary" href="/en/contact">Request a free assessment</a>
        <a class="btn ghost" href="/en/gdpr-ai">View GDPR & AI services</a>
      </div>
    </div>
  </section>
</Layout>

