---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Privacy Policy | CoverData">
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">Privacy Policy</h1>
    <p class="mt-3 text-slate-700">
      This Privacy Policy explains how CoverData processes personal data collected through this website.
    </p>

    <div class="mt-10 space-y-8 text-slate-800">
      <div>
        <h2 class="text-xl font-semibold">1. Data controller</h2>
        <p class="mt-2">
          <strong>CoverData</strong><br />
          Email: <a class="underline" href="mailto:info@cover-data.com">info@cover-data.com</a>
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold">2. Purpose</h2>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-slate-700">
          <li>Respond to contact requests submitted via the contact form.</li>
          <li>Manage professional communications.</li>
          <li>Improve our services and user experience.</li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-semibold">3. Legal basis</h2>
        <p class="mt-2 text-slate-700">Consent of the user.</p>
      </div>

      <div>
        <h2 class="text-xl font-semibold">4. Data processed</h2>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-slate-700">
          <li>Name</li>
          <li>Email</li>
          <li>Message</li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-semibold">5. Retention</h2>
        <p class="mt-2 text-slate-700">
          Data is kept only as long as necessary to respond and comply with legal obligations.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold">6. Recipients</h2>
        <p class="mt-2 text-slate-700">No data is shared unless required by law.</p>
      </div>

      <div>
        <h2 class="text-xl font-semibold">7. Your rights</h2>
        <p class="mt-2 text-slate-700">
          You can exercise your rights by contacting:
          <a class="underline" href="mailto:info@cover-data.com">info@cover-data.com</a>.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold">8. Security</h2>
        <p class="mt-2 text-slate-700">
          CoverData applies appropriate technical and organizational measures to protect personal data.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold">9. Changes</h2>
        <p class="mt-2 text-slate-700">This policy may be updated.</p>
      </div>
    </div>
  </section>
</Layout>

