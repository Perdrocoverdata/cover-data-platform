---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Cookies Policy | CoverData">
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">Cookies Policy</h1>

    <div class="mt-8 space-y-6 text-slate-700">
      <p>
        This website does not use tracking cookies (analytics or advertising). Only technical cookies may be used for
        basic operation.
      </p>
      <p>
        If analytics/marketing cookies are added in the future, this policy will be updated and a cookie banner will be
        implemented where required.
      </p>
    </div>
  </section>
</Layout>

