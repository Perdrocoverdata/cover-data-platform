---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Cookies Policy | CoverData">
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">Cookies Policy</h1>

    <div class="mt-8 space-y-6 text-slate-700">
      <p>
        This website does not use tracking cookies (analytics or advertising). Only technical cookies may be used for
        basic operation.
      </p>
      <p>
        If analytics/marketing cookies are added in the future, this policy will be updated and a cookie banner will be
        implemented where required.
      </p>
    </div>
  </section>
<footer class="bg-white border-t border-slate-200">
  <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-slate-600 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>© {new Date().getFullYear()} CoverData</div>

    <div class="flex gap-4">
      <a class="underline" href="/en/privacy">Privacy Policy</a>
      <a class="underline" href="/en/legal">Legal Notice</a>
      <a class="underline" href="/en/cookies">Cookies</a>
    </div>
  </div>
</footer>
</Layout>

