---
import Logo from './Logo.astro';

const path = Astro.url?.pathname ?? '/';
const isEn = path.startsWith('/en');
const lang = isEn ? 'en' : 'es';
const homeHref = isEn ? '/en/' : '/es/';

let menuOpen = false;

// Traducciones del menú
const t = {
    es: {
        home: 'Inicio',
        services: 'Servicios',
        about: 'Quiénes somos',
        training: 'Formación',
        contact: 'Contacto',

        risk: 'Evaluación de riesgos',
        dpia: 'DPIA / PIA',
        doubts: 'Resolución de dudas legales y técnicas',
        iso: 'ISO 27001',
        ens: 'ENS (básico, medio y alto)',
        breaches: 'Gestión de brechas de seguridad',
        transfers: 'Transferencias internacionales y SCC',
        contracts: 'Revisión de contratos y proveedores',
        policies: 'Políticas y documentación',
        internalTraining: 'Formación interna',

        mission: 'Nuestra misión',
        team: 'Equipo',
        values: 'Valores',

        rgpd: 'RGPD para empleados',
        cyber: 'Ciberseguridad básica',
        awareness: 'Concienciación',

        form: 'Formulario',
        email: 'Email',
        phone: 'Teléfono'
    },

    en: {
        home: 'Home',
        services: 'Services',
        about: 'About us',
        training: 'Training',
        contact: 'Contact',

        risk: 'Risk assessment',
        dpia: 'DPIA / PIA',
        doubts: 'Legal & technical support',
        iso: 'ISO 27001',
        ens: 'ENS (basic, medium, high)',
        breaches: 'Security breach management',
        transfers: 'International transfers & SCC',
        contracts: 'Contract & vendor review',
        policies: 'Policies & documentation',
        internalTraining: 'Internal training',

        mission: 'Our mission',
        team: 'Team',
        values: 'Values',

        rgpd: 'GDPR for employees',
        cyber: 'Basic cybersecurity',
        awareness: 'Awareness',

        form: 'Form',
        email: 'Email',
        phone: 'Phone'
    }
};
---

<div client:load>
    <nav class="w-full bg-white text-[#071A33] px-6 py-4 shadow-sm sticky top-0 z-50">
        <div class="flex items-center justify-between max-w-[1400px] mx-auto w-full">
            <!-- LOGO -->
            <a href={homeHref} class="block leading-none shrink-0" aria-label="CoverData home">
                <Logo />
            </a>

            <!-- BOTÓN HAMBURGUESA -->
            <button
                class="md:hidden text-[#071A33] text-3xl focus:outline-none transition-transform duration-300"
                on:click={() => (menuOpen = !menuOpen)}
                aria-label="Abrir menú"
            >
                {menuOpen ? '✖' : '☰'}
            </button>

            <!-- MENÚ DESKTOP -->
            <ul class="hidden md:flex items-center justify-center gap-12 font-semibold text-[20px]">
                <li><a href={homeHref} class="hover:opacity-70 transition-all">{t[lang].home}</a></li>

                <li class="nav-group relative">
                    <span class="hover:opacity-70 cursor-pointer transition-all">{t[lang].services}</span>
                    <ul class="nav-submenu animate-fade-slide">
                        <li><a href={`/${lang}/#servicios`}>{t[lang].risk}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].dpia}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].doubts}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].iso}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].ens}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].breaches}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].transfers}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].contracts}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].policies}</a></li>
                        <li><a href={`/${lang}/#servicios`}>{t[lang].internalTraining}</a></li>
                    </ul>
                </li>

                <li class="nav-group relative">
                    <span class="hover:opacity-70 cursor-pointer transition-all">{t[lang].about}</span>
                    <ul class="nav-submenu animate-fade-slide">
                        <li><a href={`/${lang}/#quienes-somos`}>{t[lang].mission}</a></li>
                        <li><a href={`/${lang}/#quienes-somos`}>{t[lang].team}</a></li>
                        <li><a href={`/${lang}/#quienes-somos`}>{t[lang].values}</a></li>
                    </ul>
                </li>

                <li class="nav-group relative">
                    <span class="hover:opacity-70 cursor-pointer transition-all">{t[lang].training}</span>
                    <ul class="nav-submenu animate-fade-slide">
                        <li><a href={`/${lang}/#formacion`}>{t[lang].rgpd}</a></li>
                        <li><a href={`/${lang}/#formacion`}>{t[lang].cyber}</a></li>
                        <li><a href={`/${lang}/#formacion`}>{t[lang].awareness}</a></li>
                    </ul>
                </li>

                <li class="nav-group relative">
                    <span class="hover:opacity-70 cursor-pointer transition-all">{t[lang].contact}</span>
                    <ul class="nav-submenu animate-fade-slide">
                        <li><a href={`/${lang}/contacto`}>{t[lang].form}</a></li>
                        <li><a href={`/${lang}/contacto`}>{t[lang].email}</a></li>
                        <li><a href={`/${lang}/contacto`}>{t[lang].phone}</a></li>
                    </ul>
                </li>
            </ul>
        </div>

        <!-- MENÚ MÓVIL -->
        {
            menuOpen && (
                <ul class="md:hidden mt-6 flex flex-col gap-4 text-[20px] font-semibold animate-fade-slide">
                    <li>
                        <a href={homeHref}>{t[lang].home}</a>
                    </li>

                    <li>
                        <details>
                            <summary class="cursor-pointer">{t[lang].services}</summary>
                            <ul class="ml-6 mt-2 flex flex-col gap-2 text-[18px]">
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].risk}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].dpia}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].doubts}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].iso}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].ens}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].breaches}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].transfers}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].contracts}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].policies}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#servicios`}>{t[lang].internalTraining}</a>
                                </li>
                            </ul>
                        </details>
                    </li>

                    <li>
                        <details>
                            <summary class="cursor-pointer">{t[lang].about}</summary>
                            <ul class="ml-6 mt-2 flex flex-col gap-2 text-[18px]">
                                <li>
                                    <a href={`/${lang}/#quienes-somos`}>{t[lang].mission}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#quienes-somos`}>{t[lang].team}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#quienes-somos`}>{t[lang].values}</a>
                                </li>
                            </ul>
                        </details>
                    </li>

                    <li>
                        <details>
                            <summary class="cursor-pointer">{t[lang].training}</summary>
                            <ul class="ml-6 mt-2 flex flex-col gap-2 text-[18px]">
                                <li>
                                    <a href={`/${lang}/#formacion`}>{t[lang].rgpd}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#formacion`}>{t[lang].cyber}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/#formacion`}>{t[lang].awareness}</a>
                                </li>
                            </ul>
                        </details>
                    </li>

                    <li>
                        <details>
                            <summary class="cursor-pointer">{t[lang].contact}</summary>
                            <ul class="ml-6 mt-2 flex flex-col gap-2 text-[18px]">
                                <li>
                                    <a href={`/${lang}/contacto`}>{t[lang].form}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/contacto`}>{t[lang].email}</a>
                                </li>
                                <li>
                                    <a href={`/${lang}/contacto`}>{t[lang].phone}</a>
                                </li>
                            </ul>
                        </details>
                    </li>
                </ul>
            )
        }
    </nav>
</div>
