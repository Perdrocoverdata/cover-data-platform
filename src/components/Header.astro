---
import Logo from "./Logo.astro";

const path = Astro.url?.pathname ?? "/";
const isEn = path.startsWith("/en");
const homeHref = isEn ? "/en/" : "/es/";
---

<nav class="w-full bg-[#071A33] text-white flex items-center justify-between px-6 py-6 relative z-50">

  <!-- LOGO -->
  <a href={homeHref} class="block leading-none shrink-0" aria-label="CoverData home">
    <Logo />
  </a>

  <!-- MENÚ -->
  <ul class="flex items-center gap-10 text-sm font-semibold">

    <!-- INICIO TEST-->
    <li>
      <a href="/es/" class="hover:opacity-80">INICIO TEST</a>
    </li>

    <!-- SERVICIOS -->
    <li class="nav-group relative">
      <span class="hover:opacity-80 cursor-pointer">Servicios</span>

      <ul class="nav-submenu">
        <li><a href="/es/#servicios">Evaluación de riesgos</a></li>
        <li><a href="/es/#servicios">DPIA / PIA</a></li>
        <li><a href="/es/#servicios">Resolución de dudas legales y técnicas</a></li>
        <li><a href="/es/#servicios">ISO 27001</a></li>
        <li><a href="/es/#servicios">ENS (básico, medio y alto)</a></li>
        <li><a href="/es/#servicios">Gestión de brechas de seguridad</a></li>
        <li><a href="/es/#servicios">Transferencias internacionales y SCC</a></li>
        <li><a href="/es/#servicios">Revisión de contratos y proveedores</a></li>
        <li><a href="/es/#servicios">Políticas y documentación</a></li>
        <li><a href="/es/#servicios">Formación interna</a></li>
      </ul>
    </li>

    <!-- QUIÉNES SOMOS -->
    <li class="nav-group relative">
      <span class="hover:opacity-80 cursor-pointer">Quiénes somos</span>

      <ul class="nav-submenu">
        <li><a href="/es/#quienes-somos">Nuestra misión</a></li>
        <li><a href="/es/#quienes-somos">Equipo</a></li>
        <li><a href="/es/#quienes-somos">Valores</a></li>
      </ul>
    </li>

    <!-- FORMACIÓN -->
    <li class="nav-group relative">
      <span class="hover:opacity-80 cursor-pointer">Formación</span>

      <ul class="nav-submenu">
        <li><a href="/es/#formacion">RGPD para empleados</a></li>
        <li><a href="/es/#formacion">Ciberseguridad básica</a></li>
      </ul>
    </li>

    <!-- CONTACTO -->
    <li class="nav-group relative">
      <span class="hover:opacity-80 cursor-pointer">Contacto</span>

      <ul class="nav-submenu">
        <li><a href="/es/contacto">Formulario</a></li>
        <li><a href="/es/contacto">Email</a></li>
        <li><a href="/es/contacto">Teléfono</a></li>
      </ul>
    </li>

  </ul>

</nav>

<style is:global>
  .nav-group {
    position: relative;
  }

  .nav-submenu {
    display: none;
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 10px;
    background: white;
    color: #071A33;
    padding: 16px;
    border-radius: 12px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.15);
    min-width: 240px;
    z-index: 99999;
  }

  .nav-group:hover .nav-submenu {
    display: block;
  }

  .nav-submenu li {
    list-style: none;
  }

  .nav-submenu a {
    display: block;
    padding: 6px 0;
    text-decoration: none;
    color: #071A33;
  }

  .nav-submenu a:hover {
    text-decoration: underline;
  }

  nav, .nav-group, .nav-submenu {
    overflow: visible !important;
  }
</style>
