---
import Logo from "./Logo.astro";

const path = Astro.url?.pathname ?? "/";
const isEn = path.startsWith("/en");
const homeHref = isEn ? "/en/" : "/es/";
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-0 pb-4 sm:pt-2 sm:pb-6">
  <a href={homeHref} class="block leading-none shrink-0" aria-label="CoverData home">
    <Logo />
  </a>

  <div class="flex items-center gap-2 text-sm">
    <a href="/es/" class={isEn ? "text-white/80 hover:text-white" : "text-white font-semibold"}>ES</a>
    <span class="text-white/40">|</span>
    <a href="/en/" class={isEn ? "text-white font-semibold" : "text-white/80 hover:text-white"}>EN</a>
  </div>
</nav>

