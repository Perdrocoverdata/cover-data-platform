<script>
    const btn = document.getElementById('hamburger-btn') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu') as HTMLElement | null;

    if (btn && menu) {
        const bars = btn.querySelectorAll<HTMLElement>('.hamburger-bar');

        btn.addEventListener('click', () => {
            const isOpen = menu.getAttribute('aria-hidden') === 'false';
            if (isOpen) {
                menu.style.maxHeight = '0px';
                menu.setAttribute('aria-hidden', 'true');
                btn.setAttribute('aria-expanded', 'false');
                bars[0].style.transform = '';
                bars[1].style.opacity = '1';
                bars[2].style.transform = '';
            } else {
                menu.style.maxHeight = menu.scrollHeight + 'px';
                menu.setAttribute('aria-hidden', 'false');
                btn.setAttribute('aria-expanded', 'true');
                // 7px = 5px gap between bars + 1px half bar-height — animates bars into an × shape
                bars[0].style.transform = 'translateY(7px) rotate(45deg)';
                bars[1].style.opacity = '0';
                bars[2].style.transform = 'translateY(-7px) rotate(-45deg)';
            }
        });

        document.querySelectorAll<HTMLButtonElement>('.mobile-group-toggle').forEach((toggle) => {
            toggle.addEventListener('click', () => {
                const sub = toggle.parentElement?.querySelector<HTMLElement>('.mobile-sub');
                if (!sub) return;
                const chevron = toggle.querySelector<HTMLElement>('.mobile-chevron');
                const expanded = toggle.getAttribute('aria-expanded') === 'true';
                if (expanded) {
                    sub.classList.add('hidden');
                    sub.classList.remove('flex');
                    toggle.setAttribute('aria-expanded', 'false');
                    if (chevron) chevron.style.transform = '';
                } else {
                    sub.classList.remove('hidden');
                    sub.classList.add('flex');
                    toggle.setAttribute('aria-expanded', 'true');
                    if (chevron) chevron.style.transform = 'rotate(180deg)';
                }
                // recalculate outer panel height after sub-menu toggles
                if (menu.getAttribute('aria-hidden') === 'false') {
                    menu.style.maxHeight = menu.scrollHeight + 'px';
                }
            });
        });
    }
</script>

