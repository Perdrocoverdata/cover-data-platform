        display: block;
        opacity: 1;
        transform: translateY(0);
    }

    .nav-submenu a {
        display: block;
        padding: 6px 0;
        text-decoration: none;
        color: #071a33;
        font-size: 18px;
    }

    .nav-submenu a:hover {
        text-decoration: underline;
